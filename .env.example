NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative to the publishable key; use one key from the same project.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: complaints, first-party analytics and media import. Not required for administrator sign-in.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Shared by complaint and visit rate limiting.
RATE_LIMIT_SECRET=
NEXT_PUBLIC_SITE_URL=
SLKM_PREVIEW=true
# Trusted edge: auto Vercel only when VERCEL=1; otherwise explicitly configure.
# cloudflare requires origin access restricted to Cloudflare. local is dev loopback only.
# Unverified/missing trusted IP: public complaint/visit endpoints return 503, no shared quota.
SLKM_TRUSTED_PROXY=
# Compatibility default: Supabase provider protection only. Enable supabase AFTER
# migration 202611040003, trusted proxy and RATE_LIMIT_SECRET are verified in staging.
SLKM_LOGIN_LIMITER=provider
# Enable only after confirming production domain HTTPS. No subdomains/preload.
SLKM_HSTS_ENABLED=false
